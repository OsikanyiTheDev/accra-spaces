# Template for another environment (e.g. prod) — always use a unique key.
terraform {
  backend "s3" {
    bucket       = "osikanyithedev-terraform-state-2026"
    key          = "accra-spaces/ENV/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
