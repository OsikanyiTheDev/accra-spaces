# Accra Spaces server environment
# Copy to .env.local only after the reviewed AWS deployment provides outputs.
# None of these values are AWS access credentials or secrets.

# Public API Gateway base URL. API_URL is used by the authenticated server proxy;
# NEXT_PUBLIC_API_URL is used by server-rendered public search/detail requests.
API_URL=
NEXT_PUBLIC_API_URL=

# Canonical app origin. Use the final Vercel URL in production.
AUTH_BASE_URL=http://localhost:3000

# Cognito Hosted UI / token verification configuration.
# Example domain: https://your-prefix.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1
