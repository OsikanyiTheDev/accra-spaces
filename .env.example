# Accra Spaces frontend environment (Next.js)
# Copy to .env.local and fill in real values when the API is deployed.

# Public API base URL (API Gateway HTTP API) — set after the AWS deployment is reviewed.
NEXT_PUBLIC_API_URL=

# Cognito (Hosted UI / OAuth) — populated after the auth module is planned and applied.
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1
